 namespace {
 
+struct AddIOpConversion
+    : public ElementwiseOpConversionBase<arith::AddIOp, AddIOpConversion> {
+  using Base = ElementwiseOpConversionBase<arith::AddIOp, AddIOpConversion>;
+  using Base::Base;
+  SmallVector<LLVM::AddOp> createDestOps(arith::AddIOp op, OpAdaptor adaptor,
+      ConversionPatternRewriter &rewriter, Type elemTy,
+      MultipleOperandsRange operands, Location loc) const {
+    // Overflow flags are properties, so copying the attribute dictionary loses
+    // the bounds needed to widen a proved physical-address induction variable.
+    auto flags = LLVM::IntegerOverflowFlags::none;
+    if (op.hasNoSignedWrap()) flags = flags | LLVM::IntegerOverflowFlags::nsw;
+    if (op.hasNoUnsignedWrap()) flags = flags | LLVM::IntegerOverflowFlags::nuw;
+    return {LLVM::AddOp::create(rewriter, loc, elemTy, operands[0][0], operands[0][1], flags)};
+  }
+};
